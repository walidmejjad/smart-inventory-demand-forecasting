DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smart_inventory
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Replace change_me locally with a random secret of at least 32 bytes.
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Forecasting uses completed UTC days and requires enough distinct selling days.
MIN_FORECAST_HISTORY_DAYS=30
MIN_FORECAST_SALES_DAYS=7
